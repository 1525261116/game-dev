# ---- 依赖 ----
node_modules/
.pnpm-store/
.npm-cache/

# ---- 构建产物 ----
dist/
build/
out/
*.tsbuildinfo

# ---- 可重新生成的预览（4.9MB，由命令生成，不入库以免仓库膨胀）----
# 重新生成：cd jianghu-game && pnpm preview:rig
# 静态截图 rig-preview.png 仍然入库，作为里程碑证据
jianghu-game/preview/rig-preview.html

# ---- 日志 ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- 编辑器 / IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- AI 生图原图（过程产物：带背景、尺寸未对位；正式部件在 parts/）----
# 重新生成：cd jianghu-game && ARK_API_KEY=xxx pnpm art:gen
jianghu-game/assets/chars/*/raw/

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example

# ---- 本地工具状态（WorkBuddy 会话与记忆，不纳入版本库）----
.workbuddy/

# ---- 分发用压缩包（7MB 二进制，与已入库的解压源码重复）----
# 源码在 jianghu-tools/视频抠图工具-带裁剪功能/，此包仅供本地分发
jianghu-tools/*.zip

# ---- 临时文件 ----
*.tmp
*.bak
