*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- 编辑器 / IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example

