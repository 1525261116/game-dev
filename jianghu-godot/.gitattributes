# 统一换行，避免跨平台 diff 噪音
* text=auto eol=lf

# Godot 文本资源按文本处理（保证 diff 可读）
*.gd    text
*.tscn  text
*.tres  text
*.godot text

# ─────────────────────────────────────────────────────────────
# 二进制美术/音频资源 → 建议走 Git LFS
# 启用方式：git lfs install && git lfs track 后提交本文件
# ─────────────────────────────────────────────────────────────
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.svg  text
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff2 binary
